# Copy to .env and adjust as needed. None of these are required to run the
# demo locally with defaults -- they exist for configuring the controlled
# test environment and are never read by the frontend.

# --- Flask session signing (used for the client/attacker login cookie) ---
# Set a real random value outside of local demo use.
NIDS_SECRET_KEY=nids-live-demo

# --- Packet capture (capture.py) ---
NIDS_CAPTURE_INTERFACE=
NIDS_CAPTURE_FILTER=ip and (tcp or udp)
NIDS_CAPTURE_ENABLED=1

# --- DoS/PortScan authorized attack generator (attack_generator.py) ---
# A private-LAN (RFC1918) target; auto-discovered from connected clients if unset.
NIDS_ATTACK_TARGET=

# --- DNS tunneling authorized test generator (dns_attack_generator.py) ---
NIDS_DNS_TEST_DOMAIN=nids-test.invalid
NIDS_DNS_TEST_RESOLVER=

# --- Random attack orchestration (attack_orchestrator.py) ---
ATTACK_AUTOMATION_ENABLED=1
ATTACK_COOLDOWN_SECONDS=10
# Reserved for a future continuous/automatic test mode; not used by the
# single-click LAUNCH ATTACK path in this phase.
ATTACK_MIN_DELAY_SECONDS=0
ATTACK_MAX_DELAY_SECONDS=0
ALLOWED_ATTACK_TYPES=DOS,PORTSCAN,DNS_TUNNEL
ATTACK_CORRELATION_TIMEOUT_SECONDS=30
